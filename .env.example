# Copy this file to .env.local and fill in the values.

# Auth — a long random string (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Public URL of the deployed app, e.g. https://cite.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CanLII REST API key (optional — the app falls back to URL-only parsing without it)
CANLII_API_KEY=

# Neon Postgres (pooled connection string)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sentry (optional — no-ops when unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
